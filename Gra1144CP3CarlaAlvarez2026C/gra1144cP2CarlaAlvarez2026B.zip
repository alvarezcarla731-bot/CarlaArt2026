<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MEAN GIRLS - On Wednesdays We Wear Pink</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap');
  *{cursor: url("data:image/svg+xml;utf8,[STRIPPED]"), auto;}
  body{margin:0; font-family:Arial, sans-serif; display:flex; justify-content:center; padding:20px; min-height:100vh; overflow-x:hidden; background: linear-gradient(270deg, #e9188c, #ff4db8, #ff1493, #ff7ac1, #b11d6a); background-size:800% 800%; animation:shinyPink 8s ease infinite; position:relative;}
  body::before{content:''; position:fixed; inset:0; background: radial-gradient(circle at 20% 30%, rgba(255,255,255,0.4) 0%, transparent 40%), radial-gradient(circle at 80% 70%, rgba(255,255,255,0.3) 0%, transparent 40%); animation: glitterMove 6s ease-in-out infinite alternate; pointer-events:none;}
  @keyframes shinyPink{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}} @keyframes glitterMove{0%{transform:translate(0,0)}100%{transform:translate(-20px,20px)}}
  .card{width:100%; max-width:900px; background:rgba(255,255,255,0.88); backdrop-filter:blur(16px); border-radius:20px; overflow:hidden; border:1px solid #fff; box-shadow:0 20px 50px rgba(0,0,0,0.25); position:relative; z-index:1; animation: floatCard 6s ease-in-out infinite;}
  @keyframes floatCard{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
  .header{background:#000; color:#ff7ac1; text-align:center; padding:26px; font-family:'Archivo Black'; font-size:24px; border-bottom:3px solid #e9188c; text-shadow:0 0 10px #e9188c; animation: neonPulse 1.5s alternate infinite; cursor:pointer;}
  @keyframes neonPulse{from{ text-shadow:0 0 10px #e9188c} to{ text-shadow:0 0 20px #fff, 0 0 40px #ff7ac1}}
  nav{background:rgba(255,255,255,0.9); display:flex; justify-content:center; gap:22px; padding:14px; border-bottom:2px solid #ffe0ef; position:sticky; top:0; z-index:10;}
  nav a{color:#e9188c; text-decoration:none; font-weight:900; font-size:13px; transition:0.3s;}
  nav a:hover{transform:scale(1.2) rotate(-3deg); color:#000;}
  .content{padding:28px; display:grid; grid-template-columns:180px 1fr; gap:28px; align-items:start;}
  .left-col{display:flex; flex-direction:column; gap:22px;}
  .poster-wrap{width:100%; border-radius:18px; overflow:hidden; transform:rotate(-2deg); border:3px solid #e9188c; box-shadow:0 0 25px #e9188c; background:#fff; line-height:0; transition:0.4s;}
  .poster-wrap img{width:100%; display:block;}
  .burn-book-wrap{width:100%; height:245px; perspective:800px; display:flex; justify-content:center; align-items:center; border-radius:12px; border:3px solid #000; box-shadow:8px 8px 0 #000, 0 0 25px rgba(233,24,140,0.5); overflow:hidden; background:#ff1493; line-height:0; cursor:pointer; position:relative;}
  .burn-book-wrap img{width:100%; height:100%; object-fit:cover; transform: scale(1.35); border:none; animation: spinBook 4s linear infinite; transform-style:preserve-3d;}
  .burn-book-wrap::after{content:'CLICK TO OPEN!'; position:absolute; bottom:6px; left:50%; transform:translateX(-50%); background:#000; color:#ff7ac1; font-family:'Archivo Black'; font-size:8px; padding:3px 8px; border-radius:10px; z-index:2;}
  @keyframes spinBook{0%{transform:rotateY(0deg) rotate(-2deg) scale(1.35)}50%{transform:rotateY(180deg) rotate(2deg) scale(1.45)}100%{transform:rotateY(360deg) rotate(-2deg) scale(1.35)}}
  h2{color:#e9188c; font-family:'Archivo Black'; font-size:20px; margin:30px 0 10px 0;}
  .trailer-wrap{border:3px solid #e9188c; border-radius:14px; overflow:hidden; box-shadow:0 0 20px #e9188c;}
  .trailer-wrap video{width:100%; display:block; aspect-ratio:16/9; background:#000;}
  .section{padding:0 28px 28px 28px;}
  .plastic-card{background:rgba(255,255,255,0.95); border-left:5px solid #e9188c; padding:15px; border-radius:12px; margin:15px 0; transition:0.4s; box-shadow:0 4px 15px rgba(0,0,0,0.05);}
  .plastic-card:hover{transform:translateX(10px) rotateY(-8deg); background:#fff; box-shadow:-10px 10px 30px rgba(233,24,140,0.2); border-left-width:8px;}
  .quiz{display:flex; gap:10px; flex-wrap:wrap; margin:15px 0;} .quiz button{background:#e9188c; color:#fff; border:none; padding:10px 18px; border-radius:20px; font-weight:900; transition:0.3s; box-shadow:0 4px 0 #000;}
  .quiz button:hover{transform:translateY(-3px); box-shadow:0 7px 0 #000; background:#000; color:#ff7ac1;}
  .footer{background:#111; color:#888; text-align:center; padding:22px; font-size:11px;}
  .pop-quote{position:fixed; background:#000; color:#ff7ac1; padding:8px 14px; border-radius:20px; font-weight:900; font-size:12px; font-family:'Archivo Black'; pointer-events:none; z-index:9999; animation:pop 1.2s forwards; border:2px solid #e9188c;}
  @keyframes pop{0%{transform:translate(-50%,-100%) scale(0)}20%{transform:translate(-50%,-130%) scale(1.3) rotate(-3deg)}100%{transform:translate(-50%,-250%) scale(0); opacity:0}}
  .sparkle{position:fixed; pointer-events:none; animation:sparkleFall 1s linear forwards; z-index:9999;}
  @keyframes sparkleFall{0%{transform:translateY(0) scale(1); opacity:1}100%{transform:translateY(120px) scale(0) rotate(180deg); opacity:0}}
  .vinyl-grid{display:flex; gap:20px; flex-wrap:wrap; justify-content:center; margin-top:10px;}
  .vinyl{width:120px; height:120px; border-radius:50%; background:radial-gradient(circle, #ff7ac1 15%, #000 16%, #111 30%, #e9188c 31%, #111 32%, #111 100%); display:flex; align-items:center; justify-content:center; animation: spinVinyl 3s linear infinite; box-shadow:0 0 20px rgba(233,24,140,0.6); position:relative; cursor:pointer; border:3px solid #000; transition:0.3s;}
  .vinyl:hover{transform:scale(1.1); box-shadow:0 0 40px #ff7ac1;}
  .vinyl.playing{animation-duration:0.5s; box-shadow:0 0 40px #fff, 0 0 60px #ff7ac1;}
  .vinyl::after{content:'▶'; font-size:16px; color:#000; background:#ff7ac1; width:30px; height:30px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:900;}
  .vinyl.playing::after{content:'⏸';}
  @keyframes spinVinyl{from{transform:rotate(0deg)} to{transform:rotate(360deg)}}
  .book-modal{position:fixed; inset:0; background:rgba(0,0,0,0.85); z-index:10000; display:none; align-items:center; justify-content:center; padding:20px;}
  .book-page{width:90%; max-width:500px; background:#fff; background-image: repeating-linear-gradient(#fff 0px, #fff 24px, #ffccde 25px); border:4px solid #000; padding:30px; border-radius:10px; font-family:'Comic Sans MS', cursive; position:relative; transform:rotate(-1deg); animation: openBook 0.5s ease;}
  @keyframes openBook{from{transform:rotateY(-90deg) scale(0.5)} to{transform:rotateY(0deg) rotate(-1deg) scale(1)}}
  .secret-input{display:flex; gap:10px; margin:15px 0;} .secret-input input{flex:1; padding:10px; border:3px solid #e9188c; border-radius:20px; font-weight:900;} .secret-input button{background:#000; color:#ff7ac1; border:none; padding:10px 18px; border-radius:20px; font-weight:900; cursor:pointer;}
  .pink-car{position:fixed; bottom:20px; left:-200px; font-size:40px; z-index:9999; pointer-events:none; display:none; transition: left 2.5s linear;}
  .yt-box{margin-top:15px; border:3px solid #e9188c; border-radius:12px; overflow:hidden; background:#000;}
  .yt-box video{width:100%; height:280px; display:block; background:#000;}
  @media(max-width:650px){ .content{grid-template-columns:1fr;} .poster-wrap, .burn-book-wrap{width:180px; margin:0 auto;} }
</style>
</head>
<body>
<div class="card">
  <div class="header" onclick="sayPink()">MEAN GIRLS - ON WEDNESDAYS WE WEAR PINK 💅</div>
  <nav><a href="#about">About</a><a href="#cast">Cast/Crew</a><a href="#trailer">Trailer</a><a href="#theaters">Theaters</a><a href="#soundtrack">Sound Track</a></nav>
  <div class="content">
    <div class="left-col">
      <div class="poster-wrap"><img src="../../Documents/gra1144cP1CarlaAlvarez2026/gra1144cp1CarlaAlvarez2026B/gra1144cP2CarlaAlvarez2026B/Gra1144CP3CarlaAlvarez2026C/266280.jpg" alt="Mean Girls"></div>
      <div class="burn-book-wrap" onclick="openBook()"><img src="../../Documents/gra1144cP1CarlaAlvarez2026/gra1144cp1CarlaAlvarez2026B/gra1144cP2CarlaAlvarez2026B/Gra1144CP3CarlaAlvarez2026C/Hot Pink Burn Book Cutout.png" alt="Burn Book"></div>
    </div>
    <div>
      <h2 id="about">About</h2>
      <div class="plastic-card"><span id="typewriter"></span></div>
      <h2 id="trailer">Trailer</h2>
      <div class="trailer-wrap"><video controls poster="../../Documents/gra1144cP1CarlaAlvarez2026/gra1144cp1CarlaAlvarez2026B/gra1144cP2CarlaAlvarez2026B/Gra1144CP3CarlaAlvarez2026C/266280.jpg"><source src="../../Documents/gra1144cP1CarlaAlvarez2026/gra1144cp1CarlaAlvarez2026B/gra1144cP2CarlaAlvarez2026B/Gra1144CP3CarlaAlvarez2026C/Mean-Girls-video" type="video/mp4"></video></div>
    </div>
  </div>
  <div class="section">
    <h2 id="cast">Cast / Crew - Burn Book </h2>
    <div class="plastic-card"><strong>Cast:</strong> Lindsay Lohan, Rachel McAdams, Lacey Chabert, Amanda Seyfried<br><strong>Crew:</strong> Directed by Mark Waters | Written by Tina Fey</div>
    <h2>Which Plastic Are You? 💋</h2>
    <div class="quiz">
      <button onclick="result('You are REGINA - a little bit dramatic but everyone loves you 👑')">💖 Regina</button>
      <button onclick="result('You are CADY - sweet but will strike if needed 😇')">🌸 Cady</button>
      <button onclick="result('You are GRETCHEN - stop trying to make fetch happen! So loyal 💄')">👛 Gretchen</button>
      <button onclick="result('You are KAREN - you are like a mouse, duh! So cute 💫')">💫 Karen</button>
    </div>
    <div id="quizResult" class="plastic-card" style="display:none; background:#000; color:#ff7ac1; border-left-color:#000; font-weight:900;"></div>
    <h2 id="theaters">Theaters</h2>
    <div class="plastic-card" onclick="driveCar()" style="cursor:pointer;">📍 Now Playing: AMC Aventura • Regal South Beach • CMX Brickell — <em>Click me! Get in loser!</em> 🚗</div>
    <h2 id="soundtrack">Sound Track - Click vinyl to PLAY VIDEO!</h2>
    <div class="plastic-card"> 
      <div class="vinyl-grid">
        <div style="text-align:center;">
          <div class="vinyl" id="videopicturevinyl" onclick="playLocalVideo('videopicture', this)"></div>
          <small style="font-weight:900; display:block; margin-top:8px;">Milkshake - Kelis<br><span style="color:#e9188c;">CLICK TO PLAY VIDEO 📼</span></small>
        </div>
        <div style="text-align:center;">
          <div class="vinyl" onclick="playLocalVideo('godisadj.mp4', this)"></div>
          <small style="font-weight:900; display:block; margin-top:8px;">God Is a DJ - Pink<br><span style="color:#e9188c;">CLICK TO PLAY VIDEO 📼</span></small>
        </div>
        <div style="text-align:center;">
          <div class="vinyl" onclick="playLocalVideo('oneway.mp4', this)"></div>
          <small style="font-weight:900; display:block; margin-top:8px;">One Way - Blondie<br><span style="color:#e9188c;">CLICK TO PLAY VIDEO 📼</span></small>
        </div>
      </div>
      <div class="yt-box" id="ytBox">
        <video id="mainVideoPlayer" controls playsinline poster="../../Documents/gra1144cP1CarlaAlvarez2026/gra1144cp1CarlaAlvarez2026B/gra1144cP2CarlaAlvarez2026B/Gra1144CP3CarlaAlvarez2026C/266280.jpg">
          <source id="videoSource" src="" type="video/mp4">
        </video>
      </div>
      <div id="nowPlaying" style="margin-top:10px; background:#000; color:#ff7ac1; padding:10px; border-radius:20px; font-weight:900; font-size:12px; display:none; text-align:center;"></div>
      <p style="font-size:10px; font-weight:900; text-align:center; margin-top:5px;">👆 Click vinyl above to load video here! 🔊 Turn up volume!</p>
      <div style="margin-top:15px;">
        <div class="secret-input"><input id="secretPass" placeholder="Enter secret password... hint: fetch"><button onclick="checkSecret()">Unlock</button></div>
        <div id="secretPage" style="display:none; background:#000; color:#ff7ac1; padding:15px; border-radius:12px; font-weight:900; border:2px solid #e9188c;">🔓 SECRET PAGE UNLOCKED!<br><br>Regina: Fugly cow 🐄<br>Gretchen: Full of secrets 🤫<br>Karen: I'm a mouse duh!<br><br>So fetch!</div>
      </div>
    </div>
  </div>
  <div class="footer">© 2026, Carla Alvarez. Fictitious page for education.</div>
</div>
<div class="book-modal" id="bookModal" onclick="closeBook()">
  <div class="book-page" onclick="event.stopPropagation()">
    <h3 style="font-family:'Archivo Black'; color:#e9188c;">🔥 Burn Book 🔥</h3>
    <p><strong>Regina:</strong> Fugly cow, queen bee but totally fake.</p>
    <p><strong>Gretchen:</strong> Hair full of secrets!</p>
    <p><strong>Karen:</strong> I'm a mouse, duh!</p>
    <button onclick="closeBook()" style="background:#e9188c; color:#fff; border:none; padding:10px 20px; border-radius:20px; font-weight:900; margin-top:10px;">Close Book 💅</button>
  </div>
</div>
<div class="pink-car" id="pinkCar">🚗💨💖</div>
<script>
const aboutText = "Cady Heron joins the Plastics at her new school until she falls for Regina George's ex. So fetch! On Wednesdays we wear pink!";
let i=0; function typeWriter(){ if(i < aboutText.length){ document.getElementById("typewriter").innerHTML += aboutText.charAt(i); i++; setTimeout(typeWriter, 25); } } typeWriter();
const quotes = ["On Wednesdays we wear pink!", "You go Glen Coco!", "She doesn't even go here!", "That's so fetch!", "Get in loser!", "Is butter a carb?"];
document.addEventListener('click', (e)=>{
  if(e.target.tagName==='BUTTON' || e.target.closest('.vinyl') || e.target.closest('.burn-book-wrap') || e.target.closest('.book-modal') || e.target.closest('video')) return;
  if(e.target.tagName==='A' || e.target.tagName==='VIDEO' || e.target.closest('nav')) return;
  const b=document.createElement('div'); b.className='pop-quote'; b.textContent=quotes[Math.floor(Math.random()*quotes.length)]; b.style.left=e.pageX+'px'; b.style.top=e.pageY+'px'; document.body.appendChild(b); setTimeout(()=>b.remove(),1200);
});
document.addEventListener('mousemove', (e)=>{ if(Math.random()>0.90){ const s=document.createElement('div'); s.className='sparkle'; s.innerHTML=['💖','✨','💄'][Math.floor(Math.random()*3)]; s.style.left=e.pageX+'px'; s.style.top=e.pageY+'px'; document.body.appendChild(s); setTimeout(()=>s.remove(),1000); }});
function result(text){ const r=document.getElementById('quizResult'); r.style.display='block'; r.textContent=text; r.animate([{transform:'scale(0) rotate(-10deg)'},{transform:'scale(1.2) rotate(3deg)'},{transform:'scale(1) rotate(0deg)'}],{duration:500});}
function openBook(){ document.getElementById('bookModal').style.display='flex'; }
function closeBook(){ document.getElementById('bookModal').style.display='none'; }
function driveCar(){ const car=document.getElementById('pinkCar'); car.style.display='block'; car.style.left='-200px'; setTimeout(()=>{ car.style.left='110%'; }, 100); setTimeout(()=>{ car.style.display='none'; }, 2600); }
function checkSecret(){ const pass=document.getElementById('secretPass').value.toLowerCase(); if(pass.includes('fetch')){ document.getElementById('secretPage').style.display='block'; result('You unlocked the secret! 🔓'); } else { result('Wrong! Hint: fetch... 🤫'); }}
function sayPink(){ const utter = new SpeechSynthesisUtterance("On Wednesdays we wear pink!"); utter.pitch=1.8; utter.rate=0.9; speechSynthesis.speak(utter); }
let currentVinyl = null;
let currentFile = null;
function playLocalVideo(file, el){
  const video = document.getElementById('mainVideoPlayer');
  const source = document.getElementById('videoSource');
  const box = document.getElementById('ytBox');
  const now = document.getElementById('nowPlaying');
  if(currentFile === file && !video.paused){
    video.pause(); el.classList.remove('playing'); now.style.display='none'; return;
  }
  if(currentVinyl) currentVinyl.classList.remove('playing');
  source.src = file;
  video.load();
  box.style.display = 'block';
  video.play().then(()=>{
    el.classList.add('playing');
    currentVinyl = el;
    currentFile = file;
    now.style.display='block';
    now.textContent = '🎬 Now Playing VIDEO: ' + file;
    box.scrollIntoView({behavior:'smooth', block:'center'});
  }).catch(err=>{
    now.style.display='block';
    now.textContent = '⚠️ Cannot play ' + file + ' - Make sure milkshake.mp4 is in same folder! Re-save that googlevideo link as Page Source, not Web Archive.';
    result('File not found! That .webarchive file wont play - need .mp4');
  });
  video.onended = () => { el.classList.remove('playing'); now.textContent = 'Finished: ' + file; };
}
</script>
</body>
</html>